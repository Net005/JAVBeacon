# Copy this file to .env before running Docker Compose.
JAVBEACON_VERSION=1.0.2
JAVBEACON_PORT=8080

# These credentials are used only when the database is created for the first
# time. Replace both passwords before starting the stack.
JAVBEACON_INITIAL_USERNAME=admin
JAVBEACON_INITIAL_PASSWORD=replace-with-a-long-random-app-password
POSTGRES_DB=javbeacon
POSTGRES_USER=javbeacon
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DATA_PATH=./data/postgres

# PostgreSQL Large Library / SSD profile. These are the same optimized
# starting points offered by JAVBeacon's database Compose generator and assume
# roughly 8 GB is available for PostgreSQL. Lower them for smaller hosts.
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=2048MB
POSTGRES_EFFECTIVE_CACHE_SIZE=6144MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_DEFAULT_STATISTICS_TARGET=200
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MIN_WAL_SIZE=2GB
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_AUTOVACUUM_MAX_WORKERS=5
POSTGRES_AUTOVACUUM_NAPTIME=30s
POSTGRES_AUTOVACUUM_VACUUM_SCALE_FACTOR=0.05
POSTGRES_AUTOVACUUM_ANALYZE_SCALE_FACTOR=0.02

# Byparr is included in Compose and is required for JavLibrary scraping. It is
# only published on the Docker host's loopback interface.
BYPARR_BIND_ADDRESS=127.0.0.1
BYPARR_PORT=8191
BYPARR_LOG_LEVEL=INFO

# Optional bootstrap settings. Most configuration is managed in the UI.
JAVBEACON_API_KEY=
JAVBEACON_FLARESOLVERR_URL=http://byparr:8191/v1
JAVBEACON_PAGE_LIMIT=5
