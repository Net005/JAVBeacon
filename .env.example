# Copy this file to .env before running Docker Compose.
JAVBEACON_VERSION=1.0.1
JAVBEACON_PORT=8080

# These credentials are used only when the database is created for the first
# time. Replace the password before starting the stack.
JAVBEACON_INITIAL_USERNAME=admin
JAVBEACON_INITIAL_PASSWORD=replace-with-a-long-random-password

# Optional bootstrap settings. Most configuration is managed in the UI.
JAVBEACON_API_KEY=
JAVBEACON_FLARESOLVERR_URL=
JAVBEACON_PAGE_LIMIT=5
